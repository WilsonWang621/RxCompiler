name: Tests

# Disabled during AST development. Rename to test.yml when semantic checks
# are ready; add Clang/REIMU setup when enabling backend tests.
on: [push, pull_request]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
        with:
          submodules: recursive

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential cmake curl python3

      - name: Run tests
        run: make test STAGE=semantic
